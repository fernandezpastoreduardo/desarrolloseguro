# Keep AUDIT_ENABLED false until the external Grumphya contract is provisioned
# and the authenticated preflight has passed in production.
AUDIT_ENABLED=false
AUDIT_JWT_PRIVATE_KEY_FILE=/opt/desarrollo-seguro/secrets/audit_jwt_private.pem
AUDIT_JWT_ISSUER=desarrolloseguro-audit
AUDIT_JWT_AUDIENCE=grumphya-audit
AUDIT_TECHNICAL_AUTH_KID=ds-auditor-2026
# Optional least-privilege subset. Omit for the complete seven-resource audit;
# ethics requires privacy because both signals use the privacy transport.
# AUDIT_SCOPES=infrastructure,application,authentication,quality,privacy,ethics,ai
AUDIT_RELEASE_ATTESTATION_PUBLIC_KEY_FILE=/opt/desarrollo-seguro/secrets/release_attestation_public.pem
AUDIT_RELEASE_ATTESTATION_KID=grumphya-release-2026
# Exact source CIDR(s) observed from the DS audit client. Never use 0.0.0.0/0 or ::/0.
# The VPS observation on 2026-11-19 reported source 31.70.130.181; Grumphya
# must still confirm that its proxy sees the same address before activation.
AUDIT_ALLOWED_NETWORKS=
# Comma-separated active JWT kids accepted by Grumphya during rotation.
AUDIT_TECHNICAL_AUTH_ALLOWED_KIDS=ds-auditor-2026
