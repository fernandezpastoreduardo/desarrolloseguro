{
  "name": "@desarrolloseguro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @desarrolloseguro/persistence build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "pretest": "pnpm --filter @desarrolloseguro/persistence build",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "pretypecheck": "pnpm --filter @desarrolloseguro/persistence build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@desarrolloseguro/core": "workspace:*",
    "@desarrolloseguro/persistence": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
