{
  "name": "@desarrolloseguro/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @desarrolloseguro/core build && pnpm --filter @desarrolloseguro/persistence build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker-entrypoint.js",
    "audit:run": "node dist/internal-audit-entrypoint.js",
    "start:processor-auditor": "node dist/processor-auditor-entrypoint.js",
    "start:coordinator": "node dist/runtime-coordinator-entrypoint.js",
    "pretest": "pnpm --filter @desarrolloseguro/core build && pnpm --filter @desarrolloseguro/persistence build",
    "test": "vitest run src scripts",
    "test:coverage": "vitest run src scripts --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "test:postgres": "pnpm --filter @desarrolloseguro/core build && pnpm --filter @desarrolloseguro/persistence build && vitest run --config vitest.postgres.config.ts",
    "pretypecheck": "pnpm --filter @desarrolloseguro/core build && pnpm --filter @desarrolloseguro/persistence build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts --max-warnings=0"
  },
  "dependencies": {
    "@desarrolloseguro/core": "workspace:*",
    "@desarrolloseguro/persistence": "workspace:*",
    "parse5": "8.0.1",
    "pg": "^8.16.3",
    "playwright": "1.65.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
