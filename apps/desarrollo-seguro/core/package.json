{
  "name": "@desarrolloseguro/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public-service-catalog": {
      "types": "./dist/public-service-catalog.d.ts",
      "import": "./dist/public-service-catalog.js"
    },
    "./public-service-comparison": {
      "types": "./dist/public-service-comparison.d.ts",
      "import": "./dist/public-service-comparison.js"
    },
    "./first-entry-policy-access": {
      "types": "./dist/first-entry-policy-access.d.ts",
      "import": "./dist/first-entry-policy-access.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
