{
  "name": "@desarrolloseguro/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "predev": "pnpm --filter @desarrolloseguro/core build",
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run && cd ../../.. && node scripts/test-public-site-pages.mjs && node scripts/test-report-badge-issuer.mjs",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "pretypecheck": "pnpm --filter @desarrolloseguro/core build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e --max-warnings=0",
    "prebuild": "pnpm --filter @desarrolloseguro/core build",
    "build": "vite build && node scripts/build-public-site-assets.mjs"
  },
  "dependencies": {
    "@desarrolloseguro/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sass": "1.106.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.7",
    "vitest": "4.1.12"
  }
}
