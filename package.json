{
  "name": "desarrolloseguro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @desarrolloseguro/api --filter @desarrolloseguro/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "test:postgres": "pnpm --filter @desarrolloseguro/persistence test:postgres",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "migrations:check": "node scripts/check-migration-registry.mjs",
    "ci:verify": "bash scripts/ci-verify.sh",
    "quality:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
